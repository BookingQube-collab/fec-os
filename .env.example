# Copy to .env.local and fill in values from Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

SUPABASE_PROJECT_ID=your-project-ref
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
# IPv4-friendly session pooler (Supabase Dashboard → Connect) — use for migrations from Windows
SESSION_POOLER_DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Cron endpoints (/api/public/*) — generate with: openssl rand -hex 32
CRON_SECRET=

# External attendance ingest (POST /api/public/attendance-ingest) — see docs/api/attendance-ingest.md
# Generate: openssl rand -hex 32
ATTENDANCE_INGEST_API_KEY=

# ZKTeco ADMS / iClock push (/iclock/cdata). Device SN must be mapped in People → Time & Attendance → Settings.
# Optional shared secret: send as query pushcommkey or header X-ADMS-Key. Set the same value on the device if firmware has Server Auth.
# Generate: openssl rand -hex 32
ADMS_COMM_KEY=
# Optional comma-separated source IPs (venue public NAT). Empty = any IP with a mapped SN.
# ADMS_IP_ALLOWLIST=

# Optional: outbound email (Admin → Email UI preferred; env remains the fallback)
# NOTIFICATION_EMAIL_WEBHOOK=https://hooks.example/email
# RESEND_API_KEY=
# MAINTENANCE_EMAIL_FROM=noreply@fec.qa
# EMAIL_FROM=noreply@fec.qa
NOTIFICATION_EMAIL_WEBHOOK=
# Get a key from Lovable AI gateway or use OPENAI_API_KEY as fallback for checklist generation.
LOVABLE_API_KEY=
OPENAI_API_KEY=

# Stable Server Action encryption key across all instances / deploys (base64 AES-128/192/256).
# Generate: openssl rand -base64 32
# Set at build time so action IDs stay decryptable after rolling deploys.
# Without this, browsers on an old bundle can hit "Failed to find Server Action".
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Server-only master key for AI provider credentials at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
# Never commit the real value. Never expose to the browser.
AI_CREDENTIALS_ENCRYPTION_KEY=

# Optional dedicated key for attendance original-file encryption at rest.
# Falls back to AI_CREDENTIALS_ENCRYPTION_KEY when unset.
ATTENDANCE_FILE_ENCRYPTION_KEY=

# Optional public origin used as OpenRouter HTTP-Referer (not a secret).
# NEXT_PUBLIC_SITE_URL=https://your-fec-os-domain.example
# Ops manual (MkDocs): default http://127.0.0.1:8000 when running mkdocs serve locally
# Production (GitHub Pages): https://bookingqube-collab.github.io/fec-os/
# NEXT_PUBLIC_OPS_MANUAL_URL=https://bookingqube-collab.github.io/fec-os/
# AI_HTTP_REFERER=https://your-fec-os-domain.example

# Team Chat (/ember) uses FEC Chat Hub on Vercel + Supabase — no Cloudflare URL needed.
# See docs/ember-team-chat.md

# LiveKit media (Chat Hub calls + Call Center softphone). Prefer Admin → Chat calls UI;
# these env vars are a server-only fallback when the DB row is incomplete.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Call Center recording egress (LiveKit → S3/R2/Supabase S3). Optional if LiveKit Cloud
# default egress storage is enabled; either way point the LiveKit project webhook at
# /api/public/call-center/livekit-sip so egress_ended can write recording_url on the CDR.
# Also set Call Center → Settings → Recording storage base URL to the public HTTPS CDN/base
# that serves objects under {base}/call-center/{callId}.mp4.
# LIVEKIT_EGRESS_S3_ACCESS_KEY=
# LIVEKIT_EGRESS_S3_SECRET=
# LIVEKIT_EGRESS_S3_BUCKET=
# LIVEKIT_EGRESS_S3_REGION=auto
# LIVEKIT_EGRESS_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=true

# Call Center webhooks (Telnyx / LiveKit SIP). Prefer Admin → Call Center secrets;
# env is a fallback. Never use NEXT_PUBLIC_ for these.
# CALL_CENTER_WEBHOOK_SECRET=
# TELNYX_WEBHOOK_SECRET=
# TELNYX_PUBLIC_KEY=   # ed25519 public key for Call Control webhook signatures
# TELNYX_API_KEY=
# CALL_CENTER_SIP_ROOM_PREFIX=cc-
# Piper OSS IVR Play clips under /ivr/{en,ar}/ (8 kHz mono). Default OFF (TTS).
# Both flags required before Telnyx will Play app /ivr/ URLs — silence is worse than AI tone.
# IVR_OSS_PLAY_ENABLED=1
# IVR_OSS_PLAY_VERIFIED=1


# Optional: ElevenLabs IVR voices (near-human TTS; NOT the default).
# True Qatari accent still needs recorded Play URLs on IVR nodes — see docs/call-center.md
# "Qatar / Gulf IVR voice quality".
# 1) Create an Integration Secret in Telnyx Mission Control with your ElevenLabs API key
# 2) Set the secret's identifier here
# 3) Call Center → Settings → IVR TTS EN and/or AR → Custom:
#    ElevenLabs.eleven_multilingual_v2.<voice_id>
# TELNYX_ELEVENLABS_API_KEY_REF=
# See docs/call-center.md (Telnyx SIP Trunking + Qatar DID → LiveKit)

# Optional last-resort provider keys if Admin cards are not saved yet (server-only).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# BookingQube revenue integration (see docs/BOOKINGQUBE.md)
BOOKINGQUBE_API_URL=
BOOKINGQUBE_API_KEY=
# BOOKINGQUBE_REVENUE_PATH=/revenue/daily
# BOOKINGQUBE_AUTH_STYLE=bearer
# BOOKINGQUBE_USE_MOCK=true
# Per-branch BookingQube store IDs (defaults to lowercase branch codes)
# BOOKINGQUBE_STORE_KDS_CC=
# BOOKINGQUBE_STORE_INF_CC=
# BOOKINGQUBE_STORE_UA_DM=
# BOOKINGQUBE_STORE_CB_VM=
# BOOKINGQUBE_STORE_CB_DSM=
# BOOKINGQUBE_STORE_CAR_AP=

# ---------------------------------------------------------------------------
# Meta Business APIs — WhatsApp Cloud + Instagram Messaging (official only)
# Full checklist: docs/meta-messaging.md
# WhatsApp inbox: /call-center/whatsapp — API keys/templates in Call Center → Settings
# Instagram webhook: /api/public/meta/instagram (credentials also in Settings)
# Outbound test:     /api/public/meta/send  (Bearer META_SEND_SECRET or CRON_SECRET)
# ---------------------------------------------------------------------------
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_API_VERSION=v21.0
# Shared hub.verify_token (or set WHATSAPP_VERIFY_TOKEN / INSTAGRAM_VERIFY_TOKEN)
# META_WEBHOOK_VERIFY_TOKEN=
# Reject webhook POSTs without valid X-Hub-Signature-256 when set to true/1
# META_REQUIRE_WEBHOOK_SIGNATURE=
# META_AUTO_REPLY_ENABLED=false
# META_AUTO_REPLY_TEXT=Thanks for messaging us. A team member will reply shortly.
# META_SEND_SECRET=
# Optional shared token fallback when channel-specific tokens are empty
# META_ACCESS_TOKEN=

# WhatsApp Cloud API (also configurable in Call Center → Settings)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_VERIFY_TOKEN=

# SendPulse chatbot → FEC bridge (handoff contacts/tickets only; chatbot UI stays in SendPulse)
# Prefer Call Center → Settings → SendPulse (admin). Secret is encrypted at rest with AI_CREDENTIALS_ENCRYPTION_KEY.
# Env below is fallback when admin fields are empty.
# POST /api/public/call-center/sendpulse?secret=<value>
# SENDPULSE_WEBHOOK_SECRET=
#
# Use SEPARATE WhatsApp numbers (recommended):
#   SendPulse bot WA  ≠  FEC call-center / Meta inbox WA
# SENDPULSE_WHATSAPP_NUMBER=+974XXXXXXXX   # chatbot number in SendPulse (admin preferred)
# CALL_CENTER_WHATSAPP_NUMBER=+974YYYYYYYY # FEC agent inbox number (alias: WHATSAPP_E164)
# Default: bridge creates contacts/tickets only — does NOT mirror into /call-center/whatsapp.
# Only set the next flag if you intentionally share ONE number (not recommended):
# SENDPULSE_MIRROR_WHATSAPP_INBOX=false
# Docs: docs/call-center.md (SendPulse bridge) + https://sendpulse.com/integrations/api/chatbot/webhooks

# Instagram Messaging (Page linked to Instagram Professional account)
# INSTAGRAM_PAGE_ACCESS_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# INSTAGRAM_PAGE_ID=
# META_PAGE_ID=
# INSTAGRAM_IG_USER_ID=
# INSTAGRAM_VERIFY_TOKEN=

# Facebook Messenger (Meta Page Messaging — agent channel; chatbot stays in SendPulse)
# Webhook: /api/public/meta/messenger (also configurable in Call Center → Settings)
# MESSENGER_PAGE_ACCESS_TOKEN=
# MESSENGER_PAGE_ID=
# MESSENGER_VERIFY_TOKEN=

# Microsoft 365 / Outlook email (Graph client credentials — agent handoffs)
# Webhook: /api/public/call-center/microsoft365
# Azure AD app needs application permissions: Mail.Read, Mail.Send, Mail.ReadWrite
# (admin consent). From Call Center → Email use "Sync inbox" and "Create Graph subscription".
# Notification URL must be public HTTPS (NEXT_PUBLIC_APP_URL / APP_URL).
# M365_MAILBOX=support@yourdomain.com
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
# M365_WEBHOOK_CLIENT_STATE=
# Optional HMAC for non-Graph connector posts:
# M365_WEBHOOK_HMAC_SECRET=
# Aliases: MICROSOFT365_* or AZURE_AD_TENANT_ID / AZURE_AD_CLIENT_ID / AZURE_AD_CLIENT_SECRET
# NEXT_PUBLIC_APP_URL=https://your-host.example
